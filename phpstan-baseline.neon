parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method DOMNameSpaceNode\|DOMNode\:\:getAttribute\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Api/Libraries/Services/External/GoodreadsService.php

		-
			message: '#^Strict comparison using \=\=\= between int\|string and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: app/Api/Notifications/Commands/GenerateExampleNotificationsCommand.php

		-
			message: '#^Match expression does not handle remaining value\: null$#'
			identifier: match.unhandled
			count: 1
			path: app/Api/Todos/Services/TodoService.php

		-
			message: '#^Access to an undefined property App\\Api\\Users\\Models\\FriendRequest\:\:\$direction\.$#'
			identifier: property.notFound
			count: 2
			path: app/Api/Users/Models/User.php

		-
			message: '#^Access to an undefined property App\\Api\\Users\\Models\\FriendRequest\:\:\$other_user\.$#'
			identifier: property.notFound
			count: 2
			path: app/Api/Users/Models/User.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$title\.$#'
			identifier: property.notFound
			count: 2
			path: app/Api/Users/Notifications/DailyDayReminderNotification.php

		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Auth\\PasswordBroker\:\:createToken\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Api/Users/Services/PasswordService.php

		-
			message: '#^Property App\\Bots\\DTOs\\Keyboard\:\:\$buttons is unused\.$#'
			identifier: property.unused
			count: 1
			path: app/Bots/DTOs/Keyboard.php

		-
			message: '#^Offset 0 on array\{list\<string\>\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Bots/Traits/IsTelegramBot.php

		-
			message: '#^Call to an undefined method Illuminate\\Notifications\\Notification\:\:toTelegram\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Shared/Notifications/Channels/TelegramChannel.php

		-
			message: '#^Property App\\Shared\\Notifications\\ExportReadyNotification\:\:\$exportId is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: app/Shared/Notifications/ExportReadyNotification.php

		-
			message: '#^Property App\\Shared\\Services\\IntegrationGateway\:\:\$user \(App\\Api\\Users\\Models\\User\|null\) is never assigned null so it can be removed from the property type\.$#'
			identifier: property.unusedType
			count: 1
			path: app/Shared/Services/IntegrationGateway.php

		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Cache\\Repository\:\:connection\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Shared/Services/UserCacheService.php
