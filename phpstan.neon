includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
    # Every PHPStan process boots Laravel; one worker per CPU gets the 2 GiB
    # dev container OOM-killed. `composer analyse` runs one process (--debug)
    # capped at 500M; this only limits a bare `phpstan analyse`.
    parallel:
        maximumNumberOfProcesses: 1
    excludePaths:
        - app/Dav
        - app/*/Tests/*
        - app/Api/*/Tests/*
